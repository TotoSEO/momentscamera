# ============================================================================
#  Moments Caméra — variables d'environnement
#  Copiez ce fichier en `.env.local` et remplissez ce dont vous avez besoin.
#  La boutique démarre sans aucune de ces valeurs : le tunnel de paiement
#  bascule alors en mode démonstration.
# ============================================================================

# --- Site --------------------------------------------------------------------
# Utilisé pour les URL canoniques, l'OpenGraph et le sitemap.
NEXT_PUBLIC_SITE_URL="https://momentscamera.fr"

# --- Stripe ------------------------------------------------------------------
# Tableau de bord → Développeurs → Clés d'API.
# Commencez par les clés de TEST (sk_test_… / pk_test_…).
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# Signature du webhook. En local :
#   stripe listen --forward-to localhost:3000/api/stripe/webhook
# La commande affiche un secret whsec_… à coller ici.
STRIPE_WEBHOOK_SECRET=""

# Calcul automatique de la TVA par Stripe Tax (facturé en supplément).
# Laissez "false" tant que vous n'avez pas activé et configuré Stripe Tax.
STRIPE_AUTOMATIC_TAX="false"

# --- Visuels produit -----------------------------------------------------------
# Passez à "true" une fois les fichiers d'impression du fabricant déposés
# dans public/prints/ (voir docs/MEDIAS.md). Sinon, le modèle 3D utilise les
# sérigraphies redessinées.
NEXT_PUBLIC_USE_PRINT_IMAGES="false"

# --- Expédition --------------------------------------------------------------
# "manual"  : les commandes sont journalisées, vous expédiez vous-même (défaut)
# "webhook" : les commandes sont postées sur FULFILLMENT_WEBHOOK_URL
# "alibaba" : réservé à l'API Alibaba (voir docs/ALIBABA-SOURCING.md)
FULFILLMENT_PROVIDER="manual"
FULFILLMENT_WEBHOOK_URL=""
FULFILLMENT_WEBHOOK_SECRET=""

# Identifiants Alibaba Open Platform (open.alibaba.com), une fois votre
# application validée.
ALIBABA_APP_KEY=""
ALIBABA_APP_SECRET=""
